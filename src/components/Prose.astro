---
// Long-form text (privacy policy, support guides) on a readable measure.
---

<article class="section prose-page">
  <div class="wrap">
    <div class="prose">
      <slot />
    </div>
  </div>
</article>

<style>
  .prose {
    max-width: 44rem;
    margin-inline: auto;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose :global(h1) {
    font-size: var(--t-h2);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: var(--s-5);
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: var(--s-7) 0 var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    margin: var(--s-6) 0 var(--s-3);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table) {
    margin-bottom: var(--s-4);
    color: var(--ink-muted);
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(em) {
    color: var(--ink-muted);
  }

  .prose :global(h1 + p > em) {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--t-small);
  }

  .prose :global(ul) {
    list-style: none;
    padding: 0;
  }

  .prose :global(ul > li) {
    position: relative;
    padding-left: 1.4em;
    margin-bottom: var(--s-2);
  }

  .prose :global(ul > li::before) {
    content: '';
    position: absolute;
    left: 0.2em;
    top: 0.7em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
  }

  .prose :global(ol) {
    padding-left: 1.4em;
    list-style: decimal;
  }

  .prose :global(ol > li) {
    margin-bottom: var(--s-2);
  }

  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: var(--s-3);
    border-bottom: 1px solid var(--line);
    min-width: 9rem;
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
</style>
