---
import Icon from './Icon.astro';

const points = [
  { icon: 'user', figure: '0', from: 7, title: 'Accounts', body: 'No sign-up, no email, no bank login. Open it and start.' },
  { icon: 'wifiOff', figure: '0', from: 9, title: 'Servers', body: 'Release builds have no internet permission. Nothing is uploaded.' },
  { icon: 'eyeOff', figure: '0', from: 5, title: 'Trackers', body: 'No ads, no analytics and no tracking tools. Nobody is watching.' },
  { icon: 'lock', figure: '256', from: 0, title: 'Bit backups', body: 'Backups are AES-256 encrypted with a password only you know. Add a fingerprint or face lock too.' },
] as const;
---

<section id="private" class="section private" aria-labelledby="private-title">
  <div class="wrap">
    <div class="panel reveal">
      <div class="intro">
        <p class="label label--dot">Private by design</p>
        <h2 id="private-title" class="h2">Your money is your business. <span class="muted">Not ours.</span></h2>
        <p class="lede">
          Kepa was built so that what you track stays with you. We can't see it, and nobody else can either.
        </p>
        <a class="link" href="/privacy/">Read the privacy policy <Icon name="arrowUpRight" size={16} /></a>
      </div>
      <ul class="points">
        {
          points.map((p, i) => (
            <li class="point reveal" style={`--i:${i}`}>
              <span class="ico">
                <Icon name={p.icon} />
              </span>
              <p class="fig mono" data-count={p.figure} data-from={p.from} data-duration="1300">
                {p.figure}
              </p>
              <p class="t">{p.title}</p>
              <p class="b">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-7);
    padding: clamp(var(--s-5), 4vw, var(--s-8));
    border: 1px solid var(--line);
    border-radius: var(--r-card);
  }

  .intro {
    display: grid;
    align-content: start;
    gap: var(--s-5);
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 5px;
    transition: text-decoration-color var(--d-fast) var(--ease-state);
  }

  .link:hover {
    text-decoration-color: var(--ink);
  }

  .points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
  }

  .point {
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-5);
    border-radius: var(--r-small);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .ico {
    color: var(--primary-text);
  }

  .fig {
    grid-row: span 2;
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-align: right;
  }

  .t {
    grid-column: 1 / -1;
    margin-top: var(--s-5);
    font-weight: 600;
  }

  .b {
    grid-column: 1 / -1;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  @media (max-width: 960px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { countUps } from '../scripts/motion';
  countUps(document.querySelector('#private') ?? document);
</script>
