---
// Words fill from faint to ink in reading order as the section scrolls
// through the viewport. Reduced motion (or no JS) shows it filled.
const text =
  'Most of us lose track of what comes off our account each month. A free trial that quietly became a charge. A debit order for a gym you stopped going to. A warranty slip that faded in a drawer. Kepa keeps it all in one place, and taps you on the shoulder before it costs you.';
const words = text.split(' ');
---

<section class="statement section" aria-label="Why Kepa">
  <div class="wrap">
    <p class="label label--dot">Why Kepa</p>
    <p class="text" data-fill>
      {
        words.map((w, i) => (
          <>
            <span class="w" style={`--n:${i}`}>
              {w}
            </span>{' '}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .statement {
    border-top: 1px solid var(--line);
  }

  .wrap {
    display: grid;
    gap: var(--s-6);
  }

  .text {
    max-width: 58rem;
    font-size: var(--t-statement);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  .js .text .w {
    color: var(--ink-faint);
    transition: color 260ms var(--ease-state);
  }

  .js .text .w.on {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .js .text .w {
      color: var(--ink);
      transition: none;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-fill]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    const words = Array.from(el.querySelectorAll<HTMLElement>('.w'));
    let lit = -1;
    let queued = false;
    const update = () => {
      queued = false;
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 when the block's top reaches 85% of the screen, 1 when its bottom reaches 45%.
      const start = vh * 0.85;
      const end = vh * 0.45;
      const p = Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height)));
      const n = Math.round(p * words.length) - 1;
      if (n === lit) return;
      words.forEach((w, i) => w.classList.toggle('on', i <= n));
      lit = n;
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
