---
import PhoneFrame from './PhoneFrame.astro';
import { site } from '../site';

const shots = [
  { shot: 'home', label: 'Home', alt: "Home: this week's charges and the payday card." },
  { shot: 'subscriptions', label: 'Subscriptions', alt: 'Subscriptions: every item with its next date and amount.' },
  { shot: 'insights', label: 'Insights', alt: 'Insights: yearly total and spending by category.' },
  { shot: 'detail', label: 'Item', alt: "An item's page with its schedule, reminders and payment history." },
];
---

<section class="section screens" aria-labelledby="screens-title">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="label label--dot">Inside the app</p>
      <h2 id="screens-title" class="h2">Calm, clear, <span class="muted">and quick to read.</span></h2>
    </header>
  </div>
  <div class="wrap rail-wrap">
    <ul class="rail" tabindex="0" aria-label="Screenshots, scroll sideways on small screens">
      {
        shots.map((s, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <PhoneFrame shot={s.shot} alt={s.alt} />
            <p class="label">{String(i + 1).padStart(2, '0')} / {s.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="wrap">
    <p class="note reveal">{site.amountsNote}</p>
  </div>
</section>

<style>
  .rail {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-5);
  }

  .rail li {
    display: grid;
    gap: var(--s-4);
  }

  .rail li:nth-child(even) {
    margin-top: var(--s-8);
  }

  .note {
    margin-top: var(--s-6);
    max-width: 40rem;
    font-size: var(--t-small);
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .rail-wrap {
      padding-inline: 0;
    }

    .rail {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(62vw, 260px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding-inline: var(--gutter);
      padding-bottom: var(--s-4);
      scrollbar-width: none;
    }

    .rail::-webkit-scrollbar {
      display: none;
    }

    .rail li {
      scroll-snap-align: start;
    }

    .rail li:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
