---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Features from '../components/Features.astro';
import Screens from '../components/Screens.astro';
import PrivacyPanel from '../components/PrivacyPanel.astro';
import Regions from '../components/Regions.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqList from '../components/FaqList.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import { faq } from '../faq';
---

<Base>
  <Hero />
  <Statement />
  <Features />
  <Screens />
  <PrivacyPanel />
  <Regions />
  <HowItWorks />
  <section class="section faq-home" aria-labelledby="faq-title">
    <div class="wrap layout">
      <header class="section-head reveal">
        <p class="label label--dot">Questions</p>
        <h2 id="faq-title" class="h2">Asked, <span class="muted">answered.</span></h2>
        <a class="more" href="/support/">All questions and help <Icon name="arrowUpRight" size={16} /></a>
      </header>
      <FaqList items={faq.slice(0, 4)} />
    </div>
  </section>
  <FinalCta />
</Base>

<style>
  .faq-home {
    border-top: 1px solid var(--line);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-7);
    align-items: start;
  }

  .section-head {
    margin-bottom: 0;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 5px;
  }

  .more:hover {
    text-decoration-color: var(--ink);
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
